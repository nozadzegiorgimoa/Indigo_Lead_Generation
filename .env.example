# ─────────────────────────────────────────────────────────────
# Indigo Cars Portal — environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. This file only documents the names.
# ─────────────────────────────────────────────────────────────

# --- Microsoft SQL Server connection ---
DB_SERVER=your-sql-server.database.windows.net
DB_NAME=indigo_cars
DB_USER=indigo_app
DB_PASSWORD=your-strong-password
DB_PORT=1433

# Encryption: "true" for Azure SQL and most managed servers.
DB_ENCRYPT=true
# Set to "true" only if your server uses a self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=false

# --- Auth ---
# Long random string used to sign login tokens. Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# --- One-time setup ---
# A secret you choose. Required in the x-setup-token header to call
# POST /api/setup, which creates the tables and seeds the first users.
# After setup succeeds, you may delete this variable.
SETUP_TOKEN=replace-with-another-random-string
